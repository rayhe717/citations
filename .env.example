# DeepSeek API key from https://platform.deepseek.com/
# Required for data extraction from PDFs.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Notion (main store for extracted data). See NOTION_SETUP.md.
NOTION_API_KEY=secret_your_notion_integration_secret
NOTION_DATABASE_ID=your_32_char_database_id

# Optional: server port (default 3001)
PORT=3001
