{
  "name": "cursor-citations",
  "version": "1.0.0",
  "description": "Local-first literature PDF manager with DeepSeek extraction, CSV export, and APA citations",
  "type": "module",
  "scripts": {
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
